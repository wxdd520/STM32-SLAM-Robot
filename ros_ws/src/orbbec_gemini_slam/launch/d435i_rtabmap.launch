<launch>
    <!--
        Intel RealSense D435 + RTAB-Map RGB-D SLAM 启动文件
        即插即用，无需标定。
        注意：D435 无内置 IMU，里程计仅依赖视觉。
    -->

    <!-- D435 相机参数 -->
    <arg name="camera"              default="camera"/>
    <arg name="serial_no"           default=""/>
    <arg name="depth_width"         default="-1"/>
    <arg name="depth_height"        default="-1"/>
    <arg name="color_width"         default="640"/>
    <arg name="color_height"        default="360"/>
    <arg name="color_fps"           default="15"/>
    <arg name="depth_fps"           default="15"/>
    <arg name="clip_distance"       default="-1"/>

    <!-- RTAB-Map 参数 -->
    <arg name="rtabmap_args"        default="--delete_db_on_start"/>
    <arg name="rtabmap_viz"         default="true"/>
    <arg name="rviz"                default="true"/>
    <arg name="frame_id"            default="camera_link"/>

    <!-- ============================== -->
    <!-- 1. RealSense D435 相机驱动      -->
    <!-- ============================== -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="camera"                    value="$(arg camera)"/>
        <arg name="serial_no"                 value="$(arg serial_no)"/>
        <arg name="align_depth"               value="true"/>         <!-- 深度对齐到彩色图 -->
        <arg name="enable_sync"               value="true"/>
        <arg name="enable_depth"              value="true"/>
        <arg name="enable_color"              value="true"/>
        <arg name="enable_infra"              value="false"/>
        <arg name="enable_infra1"             value="false"/>
        <arg name="enable_infra2"             value="false"/>
        <arg name="enable_pointcloud"         value="false"/>
        <arg name="enable_gyro"               value="false"/>
        <arg name="enable_accel"              value="false"/>
        <arg name="depth_width"               value="$(arg depth_width)"/>
        <arg name="depth_height"              value="$(arg depth_height)"/>
        <arg name="color_width"               value="$(arg color_width)"/>
        <arg name="color_height"              value="$(arg color_height)"/>
        <arg name="color_fps"                 value="$(arg color_fps)"/>
        <arg name="depth_fps"                 value="$(arg depth_fps)"/>
        <arg name="clip_distance"             value="$(arg clip_distance)"/>
    </include>

    <!-- ============================== -->
    <!-- 2. RTAB-Map SLAM（RGB-D 模式）   -->
    <!-- ============================== -->
    <include file="$(find rtabmap_launch)/launch/rtabmap.launch">
        <!-- RGB-D 模式 -->
        <arg name="stereo"                    value="false"/>
        <arg name="depth"                     value="true"/>
        <arg name="subscribe_rgbd"            value="false"/>
        <arg name="approx_sync"               value="true"/>
        <arg name="approx_sync_max_interval"  value="0.01"/>

        <!-- D435 话题（align_depth=true 后深度已对齐到彩色） -->
        <arg name="rgb_topic"                 value="/$(arg camera)/color/image_raw"/>
        <arg name="depth_topic"               value="/$(arg camera)/aligned_depth_to_color/image_raw"/>
        <arg name="camera_info_topic"         value="/$(arg camera)/color/camera_info"/>

        <!-- 坐标系 -->
        <arg name="frame_id"                  value="$(arg camera)_link"/>
        <arg name="odom_frame_id"             value="odom"/>
        <arg name="map_frame_id"              value="map"/>

        <!-- 里程计（纯视觉，无 IMU） -->
        <arg name="visual_odometry"           value="true"/>
        <arg name="odom_topic"                value="odom"/>
        <arg name="wait_imu_to_init"          value="false"/>

        <!-- 参数 -->
        <arg name="rtabmap_args"              value="$(arg rtabmap_args)"/>
        <arg name="rtabmap_viz"               value="$(arg rtabmap_viz)"/>
        <arg name="rviz"                      value="$(arg rviz)"/>
        <arg name="queue_size"                value="30"/>
    </include>

</launch>

<launch>
    <!--
        ZYSTM32-A1 纯导航模式（已有地图，不建图）
        =========================================
        在 RViz 中用 "2D Nav Goal" 点击目标点。

        Usage:
          roslaunch orbbec_gemini_slam zystm32_nav.launch
    -->

    <arg name="serial_port"  default="auto"/>
    <arg name="serial_baud"  default="115200"/>
    <arg name="rviz"         default="true"/>

    <!-- ============================== -->
    <!-- 1. STM32 串口桥接              -->
    <!-- ============================== -->
    <node name="stm32_bridge" pkg="orbbec_gemini_slam" type="stm32_serial_bridge.py" output="screen">
        <param name="port" value="$(arg serial_port)"/>
        <param name="baud" value="$(arg serial_baud)"/>
    </node>

    <!-- ============================== -->
    <!-- 2. D435 + RTAB-Map 定位模式     -->
    <!-- ============================== -->
    <include file="$(find orbbec_gemini_slam)/launch/d435i_rtabmap.launch">
        <arg name="rtabmap_args" value=""/>
        <arg name="rtabmap_viz"  value="false"/>
        <arg name="rviz"         value="false"/>
    </include>

    <!-- 设为定位模式（不建新地图） -->
    <node pkg="rosservice" type="rosservice" name="set_localization"
          args="call --wait /rtabmap/set_mode 1"/>

    <!-- ============================== -->
    <!-- 3. /rtabmap/grid_map → /map    -->
    <!-- ============================== -->
    <node name="map_relay" pkg="topic_tools" type="relay" args="/rtabmap/grid_map /map" output="screen"/>

    <!-- ============================== -->
    <!-- 4. 深度图 → 伪激光扫描          -->
    <!-- ============================== -->
    <node name="depthimage_to_laserscan" pkg="depthimage_to_laserscan" type="depthimage_to_laserscan" output="screen">
        <remap from="image"         to="/camera/aligned_depth_to_color/image_raw"/>
        <remap from="camera_info"   to="/camera/color/camera_info"/>
        <param name="output_frame_id" value="camera_link"/>
        <param name="range_min"       value="0.30"/>
        <param name="range_max"       value="4.50"/>
        <param name="scan_height"     value="200"/>
    </node>

    <!-- ============================== -->
    <!-- 5. move_base 导航               -->
    <!-- ============================== -->
    <node name="move_base" pkg="move_base" type="move_base" output="screen">
        <rosparam file="$(find orbbec_gemini_slam)/config/costmap_common.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find orbbec_gemini_slam)/config/costmap_common.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find orbbec_gemini_slam)/config/costmap_global.yaml"  command="load"/>
        <rosparam file="$(find orbbec_gemini_slam)/config/costmap_local.yaml"   command="load"/>
        <rosparam file="$(find orbbec_gemini_slam)/config/move_base.yaml"       command="load"/>
    </node>

    <!-- ============================== -->
    <!-- 6. RViz（含 2D Nav Goal 工具）   -->
    <!-- ============================== -->
    <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
          args="-d $(find orbbec_gemini_slam)/config/gemini_rtabmap.rviz"/>

</launch>
